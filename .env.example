# Colen configuration template.
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env        # macOS / Linux
#     copy .env.example .env      # Windows (cmd)
#
# `.env` is git-ignored — never commit real secrets.

# --- Required ------------------------------------------------------------
# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Optional ------------------------------------------------------------
# Groq chat model (default: llama-3.1-8b-instant).  If your Groq account
# cannot access it, Colen automatically falls back to the fastest available
# chat model on the key.
# COLEN_LLM_MODEL=llama-3.1-8b-instant

# Groq chat-completions endpoint.
# COLEN_GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# Local PocketTTS server endpoint (see README, "Voice setup").
# COLEN_TTS_URL=http://localhost:8000/tts

# Built-in PocketTTS voice preset (e.g. mary, alba, eve).  Set to "" or
# "file" to clone the voice from the audio file in the voices directory.
# COLEN_VOICE_NAME=mary

# Directory holding the voice-clone reference audio file.
# COLEN_VOICES_DIR=voices

# Directory used to cache generated speech clips.
# COLEN_CACHE_DIR=.colen_cache

# --- Tool Use Configuration ------------------------------------------------
# Enable system automation tools (file operations, app launching, etc.)
COLEN_ENABLE_TOOLS=true

# Confirmation mode: "strict" (always confirm), "smart" (confirm high-risk only), "relaxed" (auto-confirm)
COLEN_CONFIRMATION_MODE=smart

# Maximum file size for operations (in MB)
COLEN_MAX_FILE_SIZE_MB=100

# Maximum timeout for shell command execution (in seconds)
COLEN_MAX_COMMAND_TIMEOUT=30

# Safe directories for file operations (comma-separated)
COLEN_SAFE_DIRECTORIES=~/Documents,~/Desktop,~/Downloads

# Audit log file path
COLEN_AUDIT_LOG_PATH=~/.colen_audit.log
